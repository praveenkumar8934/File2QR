DEBUG=True
SECRET_KEY=replace_with_secure_random_string_in_production
DATABASE_URL=postgres://file2qr_user:file2qr_password@localhost:5432/file2qr
FRONTEND_URL=http://localhost:3000

# Storage Config (e.g. Cloudflare R2)
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=file2qr-private

# Quotas and Limits
MAX_FILE_SIZE=52428800

# Frontend URL for generating absolute share links
FRONTEND_PUBLIC_URL=http://localhost:3000
MAX_STORAGE_QUOTA=1073741824
MAX_FILES_PER_USER=100
